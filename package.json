{
  "name": "sailkari",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Classify local text files with GGUF models using in-process llama.cpp inference",
  "bin": {
    "sailkari": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run src",
    "test:e2e": "vitest run e2e",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
